# URL of the Cloudflare Worker that proxies The Odds API.
# Deploy the worker from cloudflare/odds-proxy/ (see its README). Use the
# custom domain (https://data.statmask.com) — the bare *.workers.dev URL is
# often blocked by corporate firewalls. When unset, the scoreboard hides the
# "Refresh Odds" button and renders normally.
VITE_ODDS_PROXY_URL=https://data.statmask.com
